[Unit]
Description=IDENT OS base runtime diagnostics
Documentation=https://github.com/Itsnicbtw/IDENTOS/blob/main/docs/base-os.md
After=systemd-udevd.service local-fs.target
ConditionPathExists=/etc/identos/release

[Service]
Type=oneshot
ExecStart=/usr/local/bin/identos-base-check
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
