#!/bin/sh
# IDENT desktop session. Openbox handles ordinary application windows.
set -eu
export XDG_CURRENT_DESKTOP=IDENT
export XDG_SESSION_DESKTOP=identos
xsetroot -solid '#101523' 2>/dev/null || true
if command -v feh >/dev/null 2>&1 && [ -f /usr/share/backgrounds/identos/identos.png ]; then
  feh --bg-fill /usr/share/backgrounds/identos/identos.svg 2>/dev/null || true
fi
openbox &
wm_pid=$!
cleanup() { kill "$wm_pid" 2>/dev/null || true; wait "$wm_pid" 2>/dev/null || true; }
trap cleanup EXIT INT TERM
/usr/local/bin/identos-panel
